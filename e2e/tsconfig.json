{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023", "DOM"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["node"],
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "noUncheckedIndexedAccess": true
    },
    "include": ["*.ts", "support/**/*.ts", "tests/**/*.ts"]
}

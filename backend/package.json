{
    "name": "keyhaven-backend",
    "version": "0.0.0",
    "private": true,
    "type": "commonjs",
    "engines": {
        "node": ">=26.13.1 <27"
    },
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
        "audit": "npm audit --omit=dev --audit-level=high",
        "postinstall": "prisma generate",
        "db:generate": "prisma generate",
        "db:migrate:create": "prisma migrate dev --create-only",
        "db:migrate:dev": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:migrate:status": "prisma migrate status",
        "db:migrate:down": "sh scripts/migrate-down.sh",
        "db:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema --exit-code",
        "db:seed": "prisma db seed",
        "db:demo-reset": "tsx prisma/demo-reset.ts && prisma migrate deploy && prisma db seed",
        "i18n:generate": "nestjs-i18n -p src/i18n -o src/generated/i18n.generated.ts",
        "i18n:check": "tsx scripts/i18n-check.ts",
        "openapi:generate": "nest build && node dist/openapi-generate.js",
        "openapi:check": "nest build && sh scripts/openapi-check.sh",
        "bench:search": "tsx scripts/bench-search.ts",
        "storage:init": "tsx scripts/storage-init.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1168.0",
        "@aws-sdk/s3-request-presigner": "3.1168.0",
        "@nestjs-cls/transactional": "4.0.2",
        "@nestjs-cls/transactional-adapter-prisma": "2.0.2",
        "@nestjs/common": "11.2.10",
        "@nestjs/config": "12.1.1",
        "@nestjs/core": "11.2.10",
        "@nestjs/platform-express": "11.2.10",
        "@nestjs/schedule": "12.0.3",
        "@nestjs/swagger": "11.4.8",
        "@nestjs/terminus": "11.1.1",
        "@prisma/adapter-pg": "7.10.1",
        "@prisma/client": "7.10.1",
        "@prometheus-io/client": "0.16.1",
        "argon2": "0.45.2",
        "cookie-parser": "1.4.7",
        "file-type": "22.3.0",
        "helmet": "8.3.0",
        "nestjs-cls": "7.0.2",
        "nestjs-i18n": "10.8.5",
        "nestjs-pino": "5.3.1",
        "nestjs-zod": "5.6.0",
        "nodemailer": "10.5.0",
        "pg": "8.23.1",
        "pino": "10.4.0",
        "pino-http": "11.0.0",
        "pino-pretty": "13.2.0",
        "rate-limiter-flexible": "11.4.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "zod": "4.6.7"
    },
    "allowScripts": {
        "argon2@0.45.2": true,
        "prisma@7.10.1": true,
        "@prisma/engines@7.10.1": true,
        "@scarf/scarf": false,
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@nestjs/cli": "11.0.24",
        "@nestjs/schematics": "11.1.0",
        "@nestjs/testing": "11.2.10",
        "@types/cookie-parser": "1.4.10",
        "@types/express": "5.0.6",
        "@types/jest": "30.0.0",
        "@types/node": "26.6.6",
        "@types/nodemailer": "8.0.2",
        "@types/pg": "8.23.1",
        "@types/supertest": "7.2.1",
        "eslint": "9.39.5",
        "eslint-plugin-simple-import-sort": "14.0.0",
        "globals": "17.14.0",
        "jest": "30.5.2",
        "lint-staged": "17.6.0",
        "prettier": "3.10.1",
        "prisma": "7.10.1",
        "supertest": "7.3.2",
        "ts-jest": "29.4.15",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.2"
    },
    "overrides": {
        "multer": "2.5.0"
    },
    "lint-staged": {
        "*.ts": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}

APP_ENV=dev
NODE_ENV=development
PORT=3000
TZ=UTC
# Where the app is opened in the browser — links in emails (verification, password reset) point here.
APP_URL=http://localhost:5180

# PostgreSQL 18 (an existing server). Credentials are URL-encoded.
DATABASE_URL=postgresql://keyhaven:keyhaven@localhost:5432/keyhaven?schema=public
DB_POOL_SIZE=10
DB_QUERY_LOG=false
# Log level: debug in dev and info in prod unless set here (silent in the tests).
LOG_LEVEL=
# Local only: `npm run db:check` and `npm run db:migrate:dev` (never at runtime).
SHADOW_DATABASE_URL=postgresql://keyhaven:keyhaven@localhost:5432/keyhaven_shadow?schema=public
# `npm test` migrates this database from scratch and runs the tests against it.
TEST_DATABASE_URL=postgresql://keyhaven:keyhaven@localhost:5432/keyhaven_test?schema=public

TRUST_PROXY_HOPS=0

# Session cookie. In production (https) use SESSION_COOKIE_NAME=__Host-keyhaven_session with
# COOKIE_SECURE=true and an empty COOKIE_DOMAIN.
SESSION_COOKIE_NAME=keyhaven_session
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Sign out after this long without activity (the app warns 2 minutes before); 7 days at most.
SESSION_IDLE_TIMEOUT_MINUTES=2880
SESSION_ABSOLUTE_TIMEOUT_MINUTES=10080

CORS_ALLOWED_ORIGINS=http://localhost:5180
SUPPORTED_LOCALES=en

# Email delivery: `log` writes every message to the log (local development, no mail server);
# `smtp` sends it through SMTP_URL (e.g. smtp://user:pass@smtp.example.com:587).
EMAIL_TRANSPORT=log
SMTP_URL=
EMAIL_FROM="Keyhaven <no-reply@keyhaven.local>"

# Object storage for uploaded listing photos: any S3-compatible service. Locally RustFS from
# docker compose (`docker compose up -d storage storage-init`): the bucket gets public reads, so
# photos are served from R2_PUBLIC_URL/<key>. In production Cloudflare R2 (R2_REGION=auto) with
# its public bucket URL. R2_INTERNAL_ENDPOINT: where the backend reaches the store when that
# differs from the address browsers upload to (docker network); empty = R2_ENDPOINT.
R2_ENDPOINT=http://localhost:9000
R2_INTERNAL_ENDPOINT=
R2_REGION=us-east-1
R2_BUCKET=keyhaven
R2_ACCESS_KEY=keyhaven
R2_SECRET_KEY=keyhaven-local
R2_PUBLIC_URL=http://localhost:9000/keyhaven

# Public demo: the showcase accounts below cannot change their password or end their sessions,
# so one visitor cannot lock the others out. Off for local development.
DEMO_MODE=false
DEMO_PROTECTED_EMAILS=

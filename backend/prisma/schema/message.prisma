/// The conversation that belongs to one viewing: it opens once the owner confirmed the viewing
/// (nobody can write to a stranger — the user's rule against spam) and stays readable after the
/// viewing was held or cancelled. One row per viewing, created with its first message; it keeps
/// when each side last read it. The owner's side is one inbox: the landlord, or every agent of
/// the agency. No `version`: no client replaces the row, the read markers only move forward.
model ViewingThread {
  viewingId     String           @id(map: "pk_viewing_threads") @map("viewing_id") @db.Uuid
  /// Cascade: the thread means nothing without its viewing (viewings are never deleted anyway).
  viewing       Viewing          @relation(fields: [viewingId], references: [id], onDelete: Cascade, map: "fk_viewing_threads_viewing_id")
  lastMessageAt DateTime         @map("last_message_at") @db.Timestamptz(3)
  /// Kept with every insert, so the thread's cap costs no count.
  messageCount  Int              @default(0) @map("message_count")
  tenantReadAt  DateTime?        @map("tenant_read_at") @db.Timestamptz(3)
  ownerReadAt   DateTime?        @map("owner_read_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  messages      ViewingMessage[]

  @@index([lastMessageAt], map: "idx_viewing_threads_last_message_at")
  @@map("viewing_threads")
}

/// One message of a viewing's conversation. Immutable (data.md): who wrote it, which side they
/// were on, the text, when — nothing is edited or deleted.
model ViewingMessage {
  id        String        @id(map: "pk_viewing_messages") @default(dbgenerated("uuidv7()")) @db.Uuid
  viewingId String        @map("viewing_id") @db.Uuid
  thread    ViewingThread @relation(fields: [viewingId], references: [viewingId], onDelete: Cascade, map: "fk_viewing_messages_viewing_id")
  senderId  String        @map("sender_id") @db.Uuid
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Restrict, map: "fk_viewing_messages_sender_id")
  /// TENANT | OWNER — the side that wrote it (CHECK in migration); unread counts are per side.
  side      String        @db.VarChar(16)
  body      String        @db.VarChar(2000)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([viewingId, createdAt], map: "idx_viewing_messages_viewing_id_created_at")
  @@index([senderId], map: "idx_viewing_messages_sender_id")
  @@map("viewing_messages")
}

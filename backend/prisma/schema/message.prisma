/// A conversation between two sides. Either the thread of one viewing (`kind = VIEWING`, its id
/// is the viewing's id, created with the first message once the owner confirmed — nobody can
/// write to a stranger, the user's rule against spam), or a member's request to Keyhaven
/// (`kind = SUPPORT`: a subject, who opened it, optionally the home it is about; admins answer
/// and close it). The requester's side is the tenant (viewing) or the member (support); the
/// responder's side the home's owner — the landlord or every agent of the agency — or the staff.
/// No `version`: no client replaces the row, the read markers only move forward.
model Conversation {
  id              String    @id(map: "pk_conversations") @default(dbgenerated("uuidv7()")) @db.Uuid
  kind            String    @db.VarChar(16)
  viewingId       String?   @unique(map: "uq_conversations_viewing_id") @map("viewing_id") @db.Uuid
  viewing         Viewing?  @relation(fields: [viewingId], references: [id], onDelete: Cascade, map: "fk_conversations_viewing_id")
  subject         String?   @db.VarChar(120)
  openedById      String?   @map("opened_by") @db.Uuid
  openedBy        User?     @relation("ConversationOpener", fields: [openedById], references: [id], onDelete: Restrict, map: "fk_conversations_opened_by")
  listingId       String?   @map("listing_id") @db.Uuid
  listing         Listing?  @relation(fields: [listingId], references: [id], onDelete: Restrict, map: "fk_conversations_listing_id")
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(3)
  lastMessageAt   DateTime  @map("last_message_at") @db.Timestamptz(3)
  messageCount    Int       @default(0) @map("message_count")
  requesterReadAt DateTime? @map("requester_read_at") @db.Timestamptz(3)
  responderReadAt DateTime? @map("responder_read_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  messages        Message[]

  @@index([lastMessageAt], map: "idx_conversations_last_message_at")
  @@index([kind, lastMessageAt], map: "idx_conversations_kind_last_message_at")
  @@index([openedById, lastMessageAt], map: "idx_conversations_opened_by_last_message_at")
  @@index([listingId], map: "idx_conversations_listing_id")
  @@map("conversations")
}

/// One message of a conversation. Immutable (SCH-4): who wrote it, which side they were on,
/// the text, when — nothing is edited or deleted, except that erasing the writer's account
/// (DATA-23) empties the body and sets `is_removed`, so the thread keeps its shape.
model Message {
  id             String       @id(map: "pk_messages") @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, map: "fk_messages_conversation_id")
  senderId       String       @map("sender_id") @db.Uuid
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict, map: "fk_messages_sender_id")
  side           String       @db.VarChar(16)
  body           String       @db.VarChar(2000)
  isRemoved      Boolean      @default(false) @map("is_removed")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([conversationId, createdAt], map: "idx_messages_conversation_id_created_at")
  @@index([senderId], map: "idx_messages_sender_id")
  @@map("messages")
}

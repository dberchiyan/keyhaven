/// One of the US cities Keyhaven serves. Reference data: listings and their time zone (viewing
/// times are shown in the listing's local time) point here.
model City {
  id        String    @id(map: "pk_cities") @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String    @db.VarChar(100)
  state     String    @db.Char(2) // USPS state code
  /// URL-safe name used in search filters (`?city=austin`).
  slug      String    @db.VarChar(100)
  /// IANA time zone of the city (America/Chicago).
  timeZone  String    @map("time_zone") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  listings  Listing[]

  @@unique([slug], map: "uq_cities_slug")
  @@map("cities")
}

/// A home for rent. Owned by a landlord (their own) or by an agency (every agent of the agency
/// manages it) — exactly one of the two, CHECK in migration. The exact address is private: it
/// is shown to the owner, admins and (M2) a tenant whose viewing was confirmed.
model Listing {
  id           String         @id(map: "pk_listings") @default(dbgenerated("uuidv7()")) @db.Uuid
  landlordId   String?        @map("landlord_id") @db.Uuid
  landlord     User?          @relation("ListingLandlord", fields: [landlordId], references: [id], onDelete: Restrict, map: "fk_listings_landlord_id")
  agencyId     String?        @map("agency_id") @db.Uuid
  agency       Agency?        @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "fk_listings_agency_id")
  title        String         @db.VarChar(120)
  description  String         @db.VarChar(4000)
  propertyType String         @map("property_type") @db.VarChar(32) // APARTMENT | HOUSE | CONDO | TOWNHOUSE | STUDIO — CHECK in migration
  /// For rent or for sale — RENT | SALE (CHECK in migration).
  kind         String         @db.VarChar(8)
  /// Monthly rent (RENT) or the asking price (SALE) — money: Decimal + currency, data.md.
  price        Decimal        @db.Decimal(19, 4)
  currency     String         @db.Char(3)
  /// 0 = studio.
  bedrooms     Int            @db.SmallInt
  /// Half baths count: 1.5.
  bathrooms    Decimal        @db.Decimal(3, 1)
  sizeSqft     Int            @map("size_sqft")
  /// Private part of the address (see the model comment).
  addressLine1 String         @map("address_line1") @db.VarChar(255)
  addressLine2 String?        @map("address_line2") @db.VarChar(255)
  /// Public part of the address.
  cityId       String         @map("city_id") @db.Uuid
  city         City           @relation(fields: [cityId], references: [id], onDelete: Restrict, map: "fk_listings_city_id")
  neighborhood String?        @db.VarChar(100)
  zip          String         @db.VarChar(10)
  petsAllowed  Boolean        @map("pets_allowed")
  furnished    Boolean
  parking      Boolean
  /// First day a tenant can move in (a calendar day, data.md → Time); null for homes for sale.
  availableFrom DateTime?     @map("available_from") @db.Date
  status       String         @db.VarChar(16) // DRAFT | PUBLISHED | UNPUBLISHED | SUSPENDED — CHECK in migration
  /// When it was last published; null while it never was.
  publishedAt  DateTime?      @map("published_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    String?        @map("created_by") @db.Uuid
  updatedBy    String?        @map("updated_by") @db.Uuid
  version      Int            @default(0)
  /// A showcase row of the public demo (set by the seed only): read-only while DEMO_MODE is on.
  isDemo       Boolean        @default(false) @map("is_demo")
  photos       ListingPhoto[]
  savedBy      SavedListing[]
  views        ListingView[]

  @@index([landlordId, status], map: "idx_listings_landlord_id_status")
  @@index([agencyId, status], map: "idx_listings_agency_id_status")
  @@index([status, cityId], map: "idx_listings_status_city_id")
  @@index([cityId], map: "idx_listings_city_id")
  @@map("listings")
}

/// A photo of a listing. Seeded photos carry an external `url`; uploaded ones live in object
/// storage under `storage_key` (public URL built from R2_PUBLIC_URL) — exactly one of the two,
/// CHECK in migration. Uploaded photos start PENDING (an intent) and become READY once the object
/// was checked; only READY photos have a `position` and are shown.
model ListingPhoto {
  id          String    @id(map: "pk_listing_photos") @default(dbgenerated("uuidv7()")) @db.Uuid
  listingId   String    @map("listing_id") @db.Uuid
  // A photo means nothing without its listing.
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade, map: "fk_listing_photos_listing_id")
  url         String?   @db.VarChar(500)
  storageKey  String?   @map("storage_key") @db.VarChar(255)
  contentType String?   @map("content_type") @db.VarChar(64)
  sizeBytes   Int?      @map("size_bytes")
  status      String    @default("READY") @db.VarChar(16) // PENDING | READY — CHECK in migration
  /// Display order; null while PENDING.
  position    Int?      @db.SmallInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?   @map("created_by") @db.Uuid

  @@unique([listingId, position], map: "uq_listing_photos_listing_id_position")
  @@unique([storageKey], map: "uq_listing_photos_storage_key")
  @@index([status, createdAt], map: "idx_listing_photos_status_created_at")
  @@map("listing_photos")
}

/// A tenant's saved home. Immutable: created_at only.
model SavedListing {
  userId    String   @map("user_id") @db.Uuid
  // Saves belong to the person.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_saved_listings_user_id")
  listingId String   @map("listing_id") @db.Uuid
  // A save means nothing without its listing.
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade, map: "fk_saved_listings_listing_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, listingId], map: "pk_saved_listings")
  @@index([listingId], map: "idx_saved_listings_listing_id")
  @@index([listingId, createdAt], map: "idx_saved_listings_listing_id_created_at")
  @@map("saved_listings")
}

/// One person opening a listing page, counted once per UTC day (the owner's "views"). Immutable.
/// Who opened a listing page: a person (once per day) or an anonymous visitor (a daily hash).
model ListingView {
  id         String   @id(map: "pk_listing_views") @default(dbgenerated("uuidv7()")) @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade, map: "fk_listing_views_listing_id")
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_listing_views_user_id")
  /// SHA-256 of the day, address and user agent of a visitor without an account.
  visitorKey String?  @map("visitor_key") @db.Char(64)
  viewedOn   DateTime @map("viewed_on") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId], map: "idx_listing_views_user_id")
  @@index([listingId, viewedOn], map: "idx_listing_views_listing_id_viewed_on")
  @@map("listing_views")
}

/// A tenant's saved search: its filters as a document (validated by Zod on write and read) and
/// whether a daily email lists new matches.
model SavedSearch {
  id             String    @id(map: "pk_saved_searches") @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_saved_searches_user_id")
  name           String    @db.VarChar(80)
  criteria       Json      @db.JsonB
  emailAlerts    Boolean   @default(true) @map("email_alerts")
  /// Listings published after this instant are "new" for the next digest; null = never sent.
  lastNotifiedAt DateTime? @map("last_notified_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(0)

  @@index([userId, createdAt], map: "idx_saved_searches_user_id_created_at")
  @@index([emailAlerts, lastNotifiedAt], map: "idx_saved_searches_email_alerts_last_notified_at")
  @@map("saved_searches")
}

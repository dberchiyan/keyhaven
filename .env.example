# Docker Compose only (docker compose up): the bundled PostgreSQL and the app's port.
# Running on your own PostgreSQL uses backend/.env instead (see README → Quick start).
DATABASE_NAME=keyhaven
DATABASE_USERNAME=keyhaven
DATABASE_PASSWORD=
# Host port of the bundled database (5432 is usually taken by a local PostgreSQL).
DATABASE_PORT=5433
APP_PORT=8080

# Public demo: the showcase accounts cannot change their password or end their sessions.
DEMO_MODE=false
DEMO_PROTECTED_EMAILS=maya.lopez@keyhaven.example,daniel.reyes@keyhaven.example,priya.nair@harborline.example,alex.morgan@keyhaven.example

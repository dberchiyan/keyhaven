---
import Cities from '@/components/sections/Cities.astro';
import Demo from '@/components/sections/Demo.astro';
import Faq from '@/components/sections/Faq.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import ForOwners from '@/components/sections/ForOwners.astro';
import Hero from '@/components/sections/Hero.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import ListingPage from '@/components/sections/ListingPage.astro';
import RentOrBuy from '@/components/sections/RentOrBuy.astro';
import SiteFooter from '@/components/sections/SiteFooter.astro';
import SiteHeader from '@/components/sections/SiteHeader.astro';
import FaqJsonLd from '@/components/seo/FaqJsonLd.astro';
import { LANDING } from '@/content/landing';
import { SITE } from '@/content/site';
import Base from '@/layouts/Base.astro';
---

<Base title={SITE.title} description={SITE.description} path="/">
  <FaqJsonLd slot="head" questions={LANDING.faq.items} />
  <SiteHeader />
  <main id="main">
    <Hero />
    <Cities />
    <RentOrBuy />
    <ListingPage />
    <HowItWorks />
    <ForOwners />
    <Demo />
    <Faq />
    <FinalCta />
  </main>
  <SiteFooter />
</Base>

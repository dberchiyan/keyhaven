---
import Container from '@/components/ui/container.astro';
import ExternalLink from '@/components/ui/external-link.astro';
import type { LegalPage } from '@/content/legal';
import { longDay } from '@/lib/format';

interface Props {
    page: LegalPage;
}

const { page } = Astro.props;
const LINK_CLASS =
    'inline-flex min-h-11 items-center gap-1.5 font-medium text-brand underline underline-offset-4 hover:text-brand-strong';
---

<article aria-labelledby="legal-title">
    <Container class="pt-12 pb-16 sm:pt-16">
        <div class="max-w-3xl">
            <h1 id="legal-title" class="type-title">
                {page.heading}
            </h1>
            <p class="mt-3 text-sm text-subtle">
                {page.updatedLabel}: <time datetime={page.updatedOn}>{longDay(page.updatedOn)}</time>
            </p>
            <p class="type-lead mt-6 text-muted">{page.lead}</p>
            {page.sections.map((section) => (
                <section aria-labelledby={section.id} class="mt-10">
                    <h2 id={section.id} class="text-xl font-semibold text-ink">
                        {section.title}
                    </h2>
                    {section.paragraphs?.map((text) => (
                        <p class="mt-3 leading-relaxed text-ink-2">{text}</p>
                    ))}
                    {section.items && (
                        <ul class="mt-3 flex list-disc flex-col gap-2 pl-5 leading-relaxed text-ink-2 marker:text-subtle">
                            {section.items.map((text) => (
                                <li>{text}</li>
                            ))}
                        </ul>
                    )}
                    {section.link && (
                        <p class="mt-3">
                            <ExternalLink href={section.link.href} class={LINK_CLASS}>
                                {section.link.label}
                            </ExternalLink>
                        </p>
                    )}
                </section>
            ))}
        </div>
    </Container>
</article>

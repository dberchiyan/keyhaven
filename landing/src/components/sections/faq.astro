---
import Container from '@/components/ui/container.astro';
import Icon from '@/components/ui/icon.astro';
import SectionHeading from '@/components/ui/section-heading.astro';
import { LANDING } from '@/content/landing';

const { faq } = LANDING;
---

<section id="faq" aria-labelledby="faq-title" class="border-t border-line bg-surface py-16 sm:py-20">
    <Container class="grid gap-12 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
        <div class="lg:sticky lg:top-28 lg:self-start">
            <SectionHeading id="faq-title" eyebrow={faq.eyebrow} title={faq.title} layout="start" />
        </div>
        <div class="reveal-list divide-y divide-line border-y border-line">
            {faq.items.map((item) => (
                <details class="group" name="faq">
                    <summary class="text-body-lg flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-5 text-left font-medium text-ink [&::-webkit-details-marker]:hidden">
                        {item.question}
                        <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-surface-2 text-muted transition-transform duration-200 group-open:rotate-45 motion-reduce:transition-none">
                            <Icon name="plus" class="size-4" />
                        </span>
                    </summary>
                    <p class="text-body max-w-2xl pb-6 leading-relaxed text-muted">{item.answer}</p>
                </details>
            ))}
        </div>
    </Container>
</section>

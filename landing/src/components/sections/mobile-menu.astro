---
import ButtonLink from '@/components/ui/button-link.astro';
import Icon from '@/components/ui/icon.astro';
import Logo from '@/components/ui/logo.astro';
import { CHROME } from '@/content/chrome';
import { SITE } from '@/content/site';

const { header } = CHROME;
---

<div
    id="mobile-menu"
    popover
    class="fixed inset-x-3 top-3 m-0 w-auto rounded-panel bg-surface p-3 text-ink-2 shadow-float ring-glass backdrop:bg-navy/30 backdrop:backdrop-blur-sm"
>
    <div class="flex items-center justify-between pb-2 pl-2">
        <Logo />
        <button
            type="button"
            popovertarget="mobile-menu"
            popovertargetaction="hide"
            class="inline-flex size-11 items-center justify-center rounded-full hover:bg-surface-2 active:scale-[0.98]"
            aria-label={header.closeMenu}
        >
            <Icon name="close" class="size-6" />
        </button>
    </div>
    <nav aria-label={header.sectionsLabel}>
        <ul class="flex flex-col">
            {header.anchors.map((anchor) => (
                <li>
                    <a
                        href={anchor.href}
                        class="flex min-h-12 items-center rounded-xl px-3 text-base font-medium hover:bg-surface-2"
                    >
                        {anchor.label}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
    <div class="mt-2 grid grid-cols-2 gap-2 border-t border-line pt-3">
        <ButtonLink href={SITE.links.signIn} variant="outline">
            {header.signIn}
        </ButtonLink>
        <ButtonLink href={SITE.links.signUp} variant="outline">
            {header.listHome}
        </ButtonLink>
    </div>
</div>

<script>
    import { closeMenuOnFollow } from './close-menu';

    closeMenuOnFollow();
</script>

---
import Avatar from '@/components/ui/avatar.astro';
import Icon from '@/components/ui/icon.astro';
import { LANDING } from '@/content/landing';
import { type DemoAccount, demoSignInHref } from '@/content/site';
import { fill } from '@/lib/format';

interface Props {
    account: DemoAccount;
}

const { account } = Astro.props;
const { demo } = LANDING;
---

<article class="flex h-full flex-col gap-5 rounded-card bg-surface p-5 shadow-card ring-glass sm:p-6">
    <header class="flex items-center gap-3">
        <Avatar name={account.name} />
        <div class="flex min-w-0 flex-1 flex-col gap-1">
            <h3 class="truncate font-semibold text-ink">{account.name}</h3>
            <p class="text-micro w-fit truncate rounded-full bg-brand-soft px-2.5 py-0.5 font-semibold text-brand-strong">
                {account.role}
            </p>
        </div>
    </header>
    <div class="flex flex-col gap-3">
        <p class="font-medium text-ink-2">{account.summary}</p>
        <ul class="flex flex-col gap-2">
            {account.items.map((item) => (
                <li class="flex min-w-0 items-center gap-2.5 text-sm text-muted">
                    <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand">
                        <Icon name="check" class="size-3" />
                    </span>
                    <span class="truncate whitespace-nowrap">{item}</span>
                </li>
            ))}
        </ul>
    </div>
    <div class="mt-auto flex flex-col gap-2 border-t border-line pt-4">
        <button
            type="button"
            class="copy text-micro sm:text-caption flex min-h-11 w-full items-center justify-between gap-2 rounded-xl bg-surface-2 px-3 text-left font-mono text-ink-2 ring-1 ring-line transition-colors hover:ring-line-strong active:scale-[0.98]"
            data-copy={account.email}
            data-copy-status={fill(demo.copiedStatus, { value: account.email })}
            aria-label={fill(demo.copyEmail, { email: account.email })}
        >
            <span class="min-w-0 truncate">{account.email}</span>
            <span class="copy-label shrink-0 font-sans text-xs font-medium text-subtle">{demo.copy}</span>
        </button>
        <a href={demoSignInHref(account)} class="btn btn-outline w-full">
            {fill(demo.signInAs, { name: account.firstName })}
            <Icon name="arrowRight" class="size-4" />
        </a>
    </div>
</article>

---
interface Props {
    label: string;
    class?: string | undefined;
}

/** A drawing of the app is one labelled image (LD-13, LD-37); its parts are decorative and hidden from assistive tech. */
const { label, class: className } = Astro.props;
---

<div role="img" aria-label={label} class:list={['select-none', className]} data-animate>
    <div aria-hidden="true" class="contents">
        <slot />
    </div>
</div>

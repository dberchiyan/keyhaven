---
import Icon from '@/components/ui/icon.astro';
import type { DashboardInterest } from '@/content/landing-types';

interface Props {
    interest: DashboardInterest;
}

const { interest } = Astro.props;
const BAR_HEIGHTS = [
    'h-0',
    'h-[10%]',
    'h-[20%]',
    'h-[30%]',
    'h-[40%]',
    'h-[50%]',
    'h-[60%]',
    'h-[70%]',
    'h-[80%]',
    'h-[90%]',
    'h-full',
] as const;
const BAR_DELAYS = ['[--i:0]', '[--i:1]', '[--i:2]', '[--i:3]', '[--i:4]', '[--i:5]', '[--i:6]', '[--i:7]'] as const;
const DAYS_PER_DELAY = 3;

/** Bars are literal height classes the build can see, never a `style` attribute (LD-45). */
const barHeight = (tenths: number): string => BAR_HEIGHTS[Math.min(tenths, BAR_HEIGHTS.length - 1)] ?? 'h-0';
const barDelay = (index: number): string => BAR_DELAYS[Math.floor(index / DAYS_PER_DELAY)] ?? '';
---

<div class="rounded-card bg-surface-2/70 p-4 ring-glass">
    <div class="flex items-start justify-between gap-4">
        <div class="flex flex-col gap-1">
            <p class="text-micro font-medium tracking-wide text-muted uppercase">
                {interest.title} · {interest.period}
            </p>
            <p class="flex items-baseline gap-2">
                <span class="text-2xl font-semibold tracking-heading text-ink tabular-nums">{interest.total}</span>
                <span class="text-caption text-muted">{interest.unit}</span>
            </p>
        </div>
        <span class="text-micro inline-flex items-center gap-1 rounded-full bg-success-bg px-2 py-0.5 font-semibold text-success-fg">
            <Icon name="trendUp" class="size-3.5" />
            {interest.change}
        </span>
    </div>
    <div class="mt-4 flex h-20 items-end gap-1">
        {interest.viewBars.map((views, index) => (
            <div class="relative flex h-full flex-1 items-end">
                <span class:list={['anim-grow w-full rounded-t-sm bg-brand/75', barHeight(views), barDelay(index)]} />
                <span
                    class:list={[
                        'anim-grow absolute inset-x-0 bottom-0 rounded-t-sm bg-warning-dot',
                        barHeight(interest.saveBars[index] ?? 0),
                        barDelay(index),
                    ]}
                />
            </div>
        ))}
    </div>
    <div class="text-micro mt-3 flex gap-4 text-muted">
        <span class="inline-flex items-center gap-1.5">
            <span class="size-2 rounded-full bg-brand"></span>
            {interest.views}
        </span>
        <span class="inline-flex items-center gap-1.5">
            <span class="size-2 rounded-full bg-warning-dot"></span>
            {interest.saves}
        </span>
    </div>
</div>

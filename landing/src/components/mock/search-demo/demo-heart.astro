---
interface Props {
    isSaved: boolean;
}

const { isSaved } = Astro.props;

const HEART = 'M12 20.5 4.9 13.6A4.6 4.6 0 0 1 11.4 7l.6.6.6-.6a4.6 4.6 0 0 1 6.5 6.6L12 20.5Z';
---

<span
    class:list={[
        'absolute top-3 right-3 flex size-9 items-center justify-center rounded-full bg-surface shadow-card',
        isSaved ? 'text-danger-dot' : 'text-ink',
    ]}
>
    <svg
        viewBox="0 0 24 24"
        class="size-4.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linejoin="round"
    >
        <path d={HEART}></path>
    </svg>
    {isSaved && (
        <svg
            viewBox="0 0 24 24"
            class="d-heart-on absolute size-4.5"
            fill="currentColor"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linejoin="round"
        >
            <path d={HEART} />
        </svg>
    )}
</span>

<script>
    // The film starts once a tenth of the frame is in view (it is taller than most viewports), and
    // the two buttons hold the only state CSS cannot: paused, and a restart.
    const observer = new IntersectionObserver(
        (entries) => {
            for (const entry of entries) {
                if (entry.isIntersecting) {
                    entry.target.setAttribute('data-visible', '');
                    observer.unobserve(entry.target);
                }
            }
        },
        { threshold: 0.1 },
    );
    for (const frame of document.querySelectorAll<HTMLElement>('[data-demo]')) {
        observer.observe(frame);
        const root = frame.parentElement;
        const pause = root?.querySelector<HTMLButtonElement>('[data-demo-pause]');
        const replay = root?.querySelector<HTMLButtonElement>('[data-demo-replay]');
        pause?.addEventListener('click', () => {
            const paused = frame.toggleAttribute('data-paused');
            pause.setAttribute('aria-pressed', String(paused));
        });
        replay?.addEventListener('click', () => {
            frame.removeAttribute('data-paused');
            pause?.setAttribute('aria-pressed', 'false');
            // Restarting every film: drop the gate, let the browser notice, put it back.
            frame.removeAttribute('data-visible');
            void frame.offsetWidth;
            frame.setAttribute('data-visible', '');
        });
    }
</script>

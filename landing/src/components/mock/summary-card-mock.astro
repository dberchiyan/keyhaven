---
import Photo from '@/components/ui/photo.astro';
import { HOME_WORDS } from '@/content/home-words';
import { LANDING } from '@/content/landing';
import type { SummaryHome } from '@/content/showcase';
import { fill } from '@/lib/format';

import MockFrame from './mock-frame.astro';
import SummaryFacts from './summary-facts.astro';

interface Props {
    home: SummaryHome;
    class?: string;
}

const { home, class: className } = Astro.props;
const { mock } = LANDING.listing;
const HEART = 'M12 20.5 4.9 13.6A4.6 4.6 0 0 1 11.4 7l.6.6.6-.6a4.6 4.6 0 0 1 6.5 6.6L12 20.5Z';
---

<MockFrame label={mock.label} class={className}>
    <div class="overflow-hidden rounded-panel bg-surface shadow-window ring-glass">
        <div class="anim-fade relative aspect-[16/9] bg-surface-2 [--i:0]">
            <Photo
                src={home.photo}
                width={1200}
                height={675}
                widths={[480, 960]}
                sizes="(min-width: 1024px) 30rem, 100vw"
                class="size-full object-cover"
            />
            <span class="absolute bottom-3 left-3 rounded-full bg-ink/70 px-2.5 py-1 text-xs font-medium text-on-brand backdrop-blur">
                {mock.photoCount}
            </span>
        </div>
        <div class="p-5 sm:p-6">
            <p class="anim-fade text-xs text-subtle [--i:0]">{fill(mock.breadcrumb, { city: home.cityName })}</p>
            <p class="anim-rise text-price mt-3 leading-none font-semibold tracking-price text-ink tabular-nums [--i:1]">
                {home.price} <span class="text-base font-medium text-muted">{HOME_WORDS.perMonth}</span>
            </p>
            <p class="anim-rise text-body mt-2 font-medium text-ink-2 [--i:2]">{home.place}</p>
            <div class="anim-rise mt-3 flex flex-wrap gap-1.5 [--i:3]">
                <span class="rounded-full bg-success-bg px-2.5 py-1 text-xs font-medium text-success-fg">
                    {mock.lister}
                </span>
                <span class="rounded-full bg-surface-2 px-2.5 py-1 text-xs font-medium text-muted">
                    {mock.listedAgo}
                </span>
            </div>
            <div class="anim-rise mt-4 rounded-xl bg-surface-2 [--i:4]">
                <SummaryFacts home={home} />
                <p class="mx-4 border-t border-line py-3 text-xs leading-relaxed text-muted">
                    {fill(mock.nearby, { count: home.nearbyCount, neighborhood: home.neighborhood ?? home.cityName })}
                    <span class="font-medium text-brand">{mock.nearbyLink}</span>
                </p>
            </div>
            <div class="anim-pop mt-4 flex items-center gap-2 [--i:5]">
                <span class="flex h-11 flex-1 items-center justify-center rounded-full bg-brand text-sm font-semibold text-on-brand">
                    {mock.contact}
                </span>
                <span class="flex size-11 items-center justify-center rounded-full bg-surface text-ink ring-1 ring-line">
                    <svg
                        viewBox="0 0 24 24"
                        class="size-5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linejoin="round"
                    >
                        <path d={HEART}></path>
                    </svg>
                </span>
            </div>
        </div>
    </div>
</MockFrame>

---
interface Props {
    name: string;
}

const { name } = Astro.props;

const TONES = [
    'bg-avatar-1',
    'bg-avatar-2',
    'bg-avatar-3',
    'bg-avatar-4',
    'bg-avatar-5',
    'bg-avatar-6',
    'bg-avatar-7',
    'bg-avatar-8',
] as const;
const HASH_SEED = 7;
const HASH_FACTOR = 31;

/** The same person has the same colour everywhere: the app hashes a name the same way. */
const toneOf = (value: string): string => {
    const hash = [...value].reduce((sum, char) => (sum * HASH_FACTOR + char.charCodeAt(0)) >>> 0, HASH_SEED);
    return TONES[hash % TONES.length] ?? TONES[0];
};

const initials = name
    .split(' ')
    .map((part) => part[0] ?? '')
    .join('')
    .slice(0, 2);
---

<span
    class:list={[
        'inline-flex size-9 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-on-avatar',
        toneOf(name),
    ]}
    aria-hidden="true"
>
    {initials}
</span>

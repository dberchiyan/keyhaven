---
import { SITE } from '@/content/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <!-- The app's mark (frontend BrandMark / favicon): a forest tile with a cream house. -->
  <svg viewBox="0 0 48 48" class="size-8 shrink-0" aria-hidden="true" focusable="false">
    <rect width="48" height="48" rx="12" class="fill-brand"></rect>
    <path d="M24 9 9 22h4v14h9V26h4v10h9V22h4z" class="fill-on-brand"></path>
    <circle cx="24" cy="20" r="2.4" class="fill-brand"></circle>
  </svg>
  <span class="text-[1.2rem] font-semibold tracking-[-0.02em] text-ink">{SITE.name}</span>
</span>
